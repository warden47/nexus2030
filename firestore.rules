rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── Helper Functions ─────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCreator() {
      return isSignedIn()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator';
    }

    // ───── Users ─────
    match /users/{userId} {
      // Owner or admin can read
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // User can create own document (role never 'admin')
      allow create: if isSignedIn()
                     && request.resource.id == request.auth.uid
                     && request.resource.data.keys().hasAll(['displayName', 'email'])
                     && request.resource.data.role in ['user', 'creator'];

      // User can update own non‑role fields; admin can update anything
      allow update: if isOwner(userId)
                     && (!('role' in request.resource.data)
                         || request.resource.data.role == resource.data.role);
      allow update: if isAdmin();

      // Only admin can delete a user document
      allow delete: if isAdmin();
    }

    // ───── Content ─────
    match /content/{contentId} {
      // Public if published, or creator/admin
      allow read: if resource.data.published == true
                   || isOwner(resource.data.creatorId)
                   || isAdmin();

      // Creator must be the authenticated user
      allow create: if isSignedIn()
                     && request.resource.data.creatorId == request.auth.uid
                     && request.resource.data.keys().hasAll(['title', 'type', 'creatorId']);

      // Creator can update own content; admin can update any
      allow update: if (isSignedIn() && resource.data.creatorId == request.auth.uid)
                     || isAdmin();

      allow delete: if isAdmin();
    }

    // ───── Watch History ─────
    match /watchHistory/{docId} {
      // Only the owner can read or modify their own history
      allow read, write: if isSignedIn()
                         && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid;
    }

    // ───── Recommendations ─────
    match /recommendations/{userId} {
      // Only the user can read their own recommendations
      allow read: if isOwner(userId);

      // Writes are performed exclusively by Cloud Functions (service account)
      allow write: if false;
    }

    // ───── Social Posts ─────
    match /socialPosts/{postId} {
      // Any authenticated user can read
      allow read: if isSignedIn();

      // Owner can create, update, delete
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ───── Live Chat ─────
    // Rate limit is enforced by a dedicated state document per user per room
    match /liveChat/{messageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid
                     && request.time == request.resource.data.timestamp   // force server timestamp
                     && (
                       !exists(/databases/$(database)/documents/liveChatState/$(request.resource.data.roomId)_$(request.auth.uid))
                       || request.time - get(/databases/$(database)/documents/liveChatState/$(request.resource.data.roomId)_$(request.auth.uid)).data.lastTimestamp > duration.time(5, "s")
                     );
    }

    // ───── Watch Parties ─────
    match /watchParties/{partyId} {
      // Only members or host can read party details
      allow read: if isSignedIn()
                   && (resource.data.hostId == request.auth.uid
                       || request.auth.uid in resource.data.members);

      // Host creates the party
      allow create: if isSignedIn()
                     && request.resource.data.hostId == request.auth.uid;

      // Host can fully update; any authenticated user can join (only add themselves to members)
      allow update: if isSignedIn()
                     && (
                       resource.data.hostId == request.auth.uid
                       || (
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                         && request.resource.data.members.hasAll(resource.data.members)
                         && request.resource.data.members.size() == resource.data.members.size() + 1
                         && request.auth.uid in request.resource.data.members
                       )
                     );

      // Host can delete the party
      allow delete: if isSignedIn()
                     && resource.data.hostId == request.auth.uid;
    }

    // ───── Creators ─────
    match /creators/{userId} {
      // Public read
      allow read: if true;

      // Owner or admin can write
      allow create, update: if isSignedIn() && (isOwner(userId) || isAdmin());

      allow delete: if isAdmin();
    }

    // ───── Transactions ─────
    match /transactions/{docId} {
      // Owner or admin can read; no client‑side writes
      allow read: if isSignedIn()
                   && (resource.data.userId == request.auth.uid || isAdmin());

      allow write: if false;
    }

    // ───── Global Deny ─────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}